{
  "name": "subterfuge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run exportar-arte && vite",
    "build": "npm run exportar-arte && tsc && vite build",
    "preview": "vite preview",
    "typecheck": "npm run exportar-arte && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verificar-rutas": "node scripts/verificar-rutas.mjs",
    "verificar-arte": "node scripts/verificar-arte.mjs",
    "exportar-arte": "node scripts/exportar-arte.mjs",
    "verificar": "npm run format:check && npm run lint && npm run typecheck && npm run verificar-arte && npm run verificar-rutas && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  }
}
