{
  "name": "subterfuge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run exportar-arte && vite",
    "build": "npm run exportar-arte && tsc && vite build",
    "preview": "vite preview",
    "typecheck": "npm run exportar-arte && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:vigilar": "vitest",
    "verificar-rutas": "node scripts/verificar-rutas.mjs",
    "verificar-textos": "node scripts/verificar-textos.mjs",
    "verificar-arte": "node scripts/verificar-arte.mjs",
    "exportar-arte": "node scripts/exportar-arte.mjs",
    "probar-tactil": "node scripts/probar-tactil.mjs",
    "verificar": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run verificar-arte && npm run verificar-rutas && npm run verificar-textos && npm run build",
    "exigir-tests": "node scripts/exigir-tests.mjs",
    "verificar-commit": "node scripts/verificar-commit.mjs",
    "sigma": "node scripts/sigma.mjs",
    "sigma:editor": "node scripts/sigma.mjs --editor",
    "sigma:tests": "node scripts/sigma.mjs --tests",
    "sigma:arte": "node scripts/arte-sigma.mjs",
    "sigma:cirujano": "node scripts/cirujano-sigma.mjs",
    "sigma:devoto": "node scripts/devoto-sigma.mjs",
    "sigma:atrezo": "node scripts/atrezo-sigma.mjs",
    "sigma:hud": "node scripts/hud-sigma.mjs",
    "sigma:fondos": "node scripts/fondos-sigma.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
