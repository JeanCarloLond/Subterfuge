[node name="Cegado" type="Node2D"]
script = ExtResource("1_habla")
id = "cegado"
nombre = "El Cegado"
retrato = ExtResource("2_retrato")
lineas = PackedStringArray("¿Pasos de Mano? Hace años que nadie de los vuestros baja esta escalera.", "No te acerques tanto. Te oigo respirar, y respiras como quien ha mirado.", "Yo también miré, una vez. Me devolví a la ley con mis propias manos. Fue lo único que hice bien.", "¿Los muros? No se mueven porque sí. Algo los llama. Algo que se está juntando.", "Antes de la Diócesis hubo otra casa: Génesis Vestal. Ellos escribían manuales; nosotros los volvimos oraciones.", "Sus laboratorios siguen ahí abajo, sellados. Lo que sabían de los Mil, la Diócesis lo rezó para no tener que entenderlo.", "Si quieres saber por qué se mueve el templo, busca sus registros.", "Lo escribí una vez en el margen de un Códice, y te lo digo a la cara, Mano: no vengas.")
otra_vez = PackedStringArray("Génesis Vestal. Sus registros. Y luego, si te queda juicio, vuelve arriba.", "Sigues aquí. Sigues mirando.", "Los muros no esperan, Mano. Y yo tampoco te voy a esperar.")
objetivo = "genesis"

