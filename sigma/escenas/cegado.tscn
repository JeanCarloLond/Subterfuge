[node name="Cegado" type="Node2D"]
script = ExtResource("1_habla")
id = "cegado"
nombre = "El Cegado"
retrato = ExtResource("2_retrato")
lineas = PackedStringArray("Para. Para, que me pisas la manta.", "Sandalias de Sala. Hace años que no baja uno de los vuestros por esta escalera.", "Y respiras por la boca. Eso es de haber mirado, no me lo niegues. Yo estuve un mes respirando así.", "Ulpiano, me llamaban. Cuando miré yo, fui a por la cucharilla antes de que me la trajeran. Es lo único que he hecho bien en la vida.", "Vienes por los muros, claro. Yo los oigo de noche. Van despacio, como quien se arrima a otro en la cama.", "Antes de la Diócesis esto lo llevaba otra casa: Génesis Vestal. Gente de cuaderno. Lo que tú rezas al entrar en Sala, ellos lo tenían escrito como instrucciones de uso.", "Nosotros les quitamos los números y le pusimos música.", "Sus laboratorios siguen ahí abajo, con los sellos puestos. Si quieres saber algo, empieza por sus registros.", "Yo lo dejé escrito en el margen de un Códice, por si bajaba alguno. «No vengas.» Y aquí estás, pisándome la manta.")
otra_vez = PackedStringArray("Otra vez tú. Se te oye desde el rellano.", "Génesis Vestal, los registros. Y si te queda juicio, vuelve arriba.", "No, no me cuentes lo que has visto. Vete.")
objetivo = "genesis"

